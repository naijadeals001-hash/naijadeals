{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@naijadeals/types": ["packages/types/src/index.ts"],
      "@naijadeals/errors": ["packages/errors/src/index.ts"],
      "@naijadeals/logger": ["packages/logger/src/index.ts"],
      "@naijadeals/config": ["packages/config/src/index.ts"],
      "@naijadeals/events": ["packages/events/src/index.ts"],
      "@naijadeals/integration-gateway": ["packages/integration-gateway/src/index.ts"],
      "@naijadeals/notification-contracts": ["packages/notification-contracts/src/index.ts"],
      "@naijadeals/ai-contracts": ["packages/ai-contracts/src/index.ts"],
      "@naijadeals/auth-contracts": ["packages/auth-contracts/src/index.ts"],
      "@naijadeals/repository": ["packages/repository/src/index.ts"],
      "@naijadeals/di": ["packages/di/src/index.ts"]
    },
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vitest/globals"]
  }
}
