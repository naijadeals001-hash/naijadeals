generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

model AuditLog {
  id            String     @id @default(cuid())
  action        String
  level         AuditLevel @default(INFO)
  actorId       String?
  actorType     String?
  targetId      String?
  targetType    String?
  correlationId String?
  requestId     String?
  reasonCode    String?
  metadata      Json?
  createdAt     DateTime   @default(now())

  @@index([action])
  @@index([actorId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String           @id @default(cuid())
  eventName     String
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String?
  causationId   String?
  status        OutboxEventStatus @default(PENDING)
  attempts      Int              @default(0)
  lastError     String?
  availableAt   DateTime         @default(now())
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())

  @@index([eventName])
  @@index([aggregateType, aggregateId])
  @@index([status, availableAt])
  @@index([correlationId])
  @@map("outbox_events")
}
