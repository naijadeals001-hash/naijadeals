generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum AuditCategory {
  AUTH
  SECURITY
  SESSION
  RBAC
  PROFILE
  OAUTH
  SYSTEM
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum UserStatus {
  PENDING
  EMAIL_UNVERIFIED
  ACTIVE
  LOCKED
  SUSPENDED
  BANNED
  ARCHIVED
}

enum OAuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
  MICROSOFT
}

model AuditLog {
  id            String        @id @default(cuid())
  action        String
  category      AuditCategory @default(SYSTEM)
  level         AuditLevel    @default(INFO)
  actorId       String?
  actorType     String?
  targetId      String?
  targetType    String?
  correlationId String?
  requestId     String?
  reasonCode    String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  @@index([action])
  @@index([category, createdAt])
  @@index([actorId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String            @id @default(cuid())
  eventName     String
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String?
  causationId   String?
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?
  availableAt   DateTime          @default(now())
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())

  @@index([eventName])
  @@index([aggregateType, aggregateId])
  @@index([status, availableAt])
  @@index([correlationId])
  @@map("outbox_events")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  displayName             String
  status                  UserStatus               @default(EMAIL_UNVERIFIED)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  passwordCredential      PasswordCredential?
  providerAccounts        ProviderAccount[]
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  userRoles               UserRole[]               @relation("UserRoleAssignments")
  roleAssignmentsMade     UserRole[]               @relation("UserRoleAssignedBy")

  @@index([status])
  @@index([emailVerifiedAt])
  @@map("users")
}

model PasswordCredential {
  id              String   @id @default(cuid())
  userId          String   @unique
  passwordHash    String
  passwordVersion Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model ProviderAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  providerEmail  String?
  linkedAt       DateTime      @default(now())
  lastLoginAt    DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("provider_accounts")
}

model AuthSession {
  id                 String    @id @default(cuid())
  userId             String
  refreshTokenHash   String    @unique
  deviceId           String?
  deviceNameSnapshot String?
  userAgent          String?
  ipAddress          String?
  lastUsedAt         DateTime?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([deviceId])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]       @relation("RoleUserAssignments")
  permissions RolePermission[] @relation("RolePermissionMappings")

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[] @relation("RolePermissionMappings")

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId           String
  roleId           String
  assignedByUserId String?
  assignedReason   String?
  assignedAt       DateTime  @default(now())
  expiresAt        DateTime?
  user             User      @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role             Role      @relation("RoleUserAssignments", fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser   User?     @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([expiresAt])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation("RolePermissionMappings", fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation("RolePermissionMappings", fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}
